# Database
CREDB_DB_URL=jdbc:postgresql://localhost:5432/credb
CREDB_DB_USER=credb
CREDB_DB_PASSWORD=change-me

# Backend
CREDB_BACKEND_PORT=8080

# Frontend
CREDB_FRONTEND_PORT=5173

# Cloudflare Workers AI (optional — only needed for semantic search)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5
CLOUDFLARE_AI_LLM_MODEL=@cf/meta/llama-3-8b-instruct

# Crawler
CREDB_CRAWLER_MACHINE_ID=local-dev-machine
CREDB_CRAWLER_SCAN_ROOTS=/home

# Semantic search
CREDB_VECTOR_ENABLED=false
